<!DOCTYPE html>
<html>
<head>
    <title>Shopping Cart System</title>
    <style>
        body {
            font-family: Arial;
            padding: 20px;
        }
        input, button {
            margin: 5px;
            padding: 8px;
        }
        table {
            border-collapse: collapse;
            margin-top: 20px;
            width: 70%;
        }
        th, td {
            border: 1px solid black;
            padding: 10px;
            text-align: center;
        }
    </style>
</head>
<body>

<h2>🛒 Shopping Cart System</h2>

<!-- Input Section -->
<h3>Add Item</h3>
<form>
    <label>Item ID:</label><br>
    <input type="number" placeholder="Enter ID"><br>

    <label>Item Name:</label><br>
    <input type="text" placeholder="Enter Name"><br>

    <label>Price:</label><br>
    <input type="number" placeholder="Enter Price"><br>

    <label>Quantity:</label><br>
    <input type="number" placeholder="Enter Quantity"><br>

    <br>
    <button type="button">Insert at Head</button>
    <button type="button">Insert at Tail</button>
    <button type="button">Delete by ID</button>
    <button type="button">Display Cart</button>
</form>

<!-- Cart Display -->
<h3>Cart Items</h3>

<table>
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Price</th>
        <th>Quantity</th>
    </tr>
    <tr>
        <td>1</td>
        <td>Shoes</td>
        <td>1500</td>
        <td>1</td>
    </tr>
    <tr>
        <td>2</td>
        <td>T-Shirt</td>
        <td>500</td>
        <td>2</td>
    </tr>
</table>

<h3>Total Cost: 2500</h3>

</body>
</html>
